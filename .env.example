# ─────────────────────────────────────────────────────────────────────────
# DevScope — root .env  (copy to .env and fill in your values)
# Used by docker-compose to inject secrets into both containers.
# NEVER commit the real .env file to git.
# ─────────────────────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────

# Required — free key at https://openrouter.ai
OPENROUTER_API_KEY=

# Optional — GitHub Personal Access Token
# Without it the GitHub API is limited to 60 req/hour.
# With it: 5 000 req/hour. Generate at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional — how long to cache an analysis result (default: 6 hours)
CACHE_TTL_HOURS=6

# ── Frontend ──────────────────────────────────────────────────────────────

# Backend URL as seen by the browser (keep localhost for local Docker)
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth — base URL of the app
NEXTAUTH_URL=http://localhost:3000

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# GitHub OAuth App credentials (optional — enables "Sign in with GitHub")
# Create one at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
