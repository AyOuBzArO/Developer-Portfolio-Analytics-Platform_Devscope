# Secrets — never bake into the image
.env.local
.env

# Dependencies — reinstalled inside the image via npm ci
node_modules

# Next.js build output — rebuilt inside the image
.next

# Auth database — persisted via Docker volume, not baked in
prisma/*.db
prisma/migrations/*/

# Git
.git
.gitignore

# Docs / editor
*.md
.AGENTS.md
CLAUDE.md

# OS
.DS_Store
Thumbs.db
